{
  "manifest_version": 3,
  "name": "Docs Bridge",
  "version": "0.4.0",
  "description": "Lets your local AI agents read and edit Google Docs and Slides as you, through this browser. Talks only to a server on 127.0.0.1.",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Docs Bridge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
